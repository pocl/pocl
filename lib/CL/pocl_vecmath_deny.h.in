/* Per-function deny lists for vectorized math libraries. GENERATED by CMake
   from pocl_vecmath_deny.h.in; edit the POCL_VECMATH_DENY_* lists in the
   top-level CMakeLists.txt, which also drive the kernel-library builtin swap.

   Each entry is an LLVM scalar function name as it appears in
   llvm/Analysis/VecFuncs.def (both the libm name and the intrinsic name
   are listed). A denied function keeps its scalar implementation and is
   not swapped to a Clang builtin in the kernel library either, so it keeps
   its SLEEF/libclc source and inline vectorization.

   Measured against the OpenCL C 3.0 ULP bounds with a 256-bit-precision
   reference over random and special inputs; provenance (library version,
   CPU, LLVM, date, the worst case) is in the CMake lists. Re-measure when
   the library or LLVM changes. */

#ifndef POCL_VECMATH_DENY_H
#define POCL_VECMATH_DENY_H

/* glibc libmvec: @POCL_VECMATH_DENY_LIBMVEC_NOTE@ */
static const char *const PoclVecMathDenyLibmvec[] = {
@POCL_VECMATH_DENY_LIBMVEC_C@
    "__pocl_vecmath_none",
};

/* SLEEF GNU-ABI build (through the libmvec table on x86): @POCL_VECMATH_DENY_SLEEF_NOTE@ */
static const char *const PoclVecMathDenySleef[] = {
@POCL_VECMATH_DENY_SLEEF_C@
    "__pocl_vecmath_none",
};

#endif
